# Python
__pycache__/
*.pyc
*.pyo

# Model checkpoints
checkpoints/*
!checkpoints/*/.gitkeep
checkpoints_*/

# HF 转换产物 (tools/convert_megatron_to_hf.py 生成，不入库)
hf/checkpoints/

# Weights & Biases (local run dirs, never commit)
wandb/

# Training data — gitignore all, selectively un-ignore small data
data/
!data/.gitkeep
!data/lite/pretrain/
!data/nano/pretrain/
!data/pro/pretrain/
!data/lite/sft/
!data/lite/dpo/
!data/nano/sft/
!data/nano/dpo/
!data/pro/sft/
!data/pro/dpo/
!data/benchmarks/
!data/raw/.gitkeep
# gleamlm/data/ 是核心库数据层（dataset/pack/pipeline/preprocess），
# 上面的 data/ 模式会递归匹配任意层级的同名目录，必须显式反忽略
!gleamlm/data/

# Tokenizer checkpoints (keep 12K, ignore test)

# Build artifacts
build/
dist/
gleamlm.egg-info/

# Documentation
docs/

# TensorBoard logs
**/runs/

# Images (training curves)
images/

# IDE
.vscode/
.idea/
.DS_Store

# IDE config
opencode.json
.claude/
AGENTS.md

# 本地 skill（复用旧仓库，不入库）
.opencode/skills/

# Local issue tracker (internal planning)
.scratch/

# Lint & type-check caches
.ruff_cache/
.mypy_cache/

# Pytest cache
.pytest_cache/

# Temporary files
*.log
temp_*
infer_result.txt

# Stale test data patterns
data/test_splits/
data/splits/*.npy
*.backup