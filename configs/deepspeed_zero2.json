{
  "train_batch_size": 64,
  "gradient_accumulation_steps": 4,
  "train_micro_batch_size_per_gpu": 4,

  "bf16": { "enabled": true },

  "zero_optimization": {
    "stage": 2,
    "reduce_bucket_size": 5e7,
    "overlap_comm": true,
    "contiguous_gradients": true,
    "round_robin_gradients": true
  },

  "gradient_clipping": 1.0,
  "steps_per_print": 10,
  "wall_clock_breakdown": false,

  "optimizer": {
    "type": "AdamW",
    "params": {
      "lr": 3e-4,
      "betas": [0.9, 0.95],
      "eps": 1e-8,
      "weight_decay": 0.1
    }
  },

  "scheduler": {
    "type": "WarmupDecayLR",
    "params": {
      "warmup_min_lr": 0,
      "warmup_max_lr": 3e-4,
      "warmup_num_steps": 1000,
      "total_num_steps": 100000
    }
  }
}
